# Magic Board — model credentials.
#
# Optional. These pre-fill the in-app Settings dialog so a deployment can ship
# with a key already configured; anything saved in the dialog takes precedence.
# Vite only exposes VITE_-prefixed vars, and they are inlined into the bundle
# at build time — a key here is visible to anyone who can load the page, so use
# it for demos/internal builds, not for a public deployment.

VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4o
VITE_LLM_API_KEY=
