{
  "name": "frontend-src",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "scenarios:export": "node --experimental-strip-types scripts/export-scenarios.mts",
    "check": "npm run check:edits && npm run check:scanner && npm run check:storage && npm run check:cache && npm run check:llm && npm run check:wire && npm run check:scenarios",
    "check:edits": "node --experimental-strip-types scripts/check-edits.mts",
    "check:scanner": "node --experimental-strip-types scripts/check-scanner.mts",
    "check:storage": "node --experimental-strip-types scripts/check-storage.mts",
    "check:cache": "node --experimental-strip-types scripts/check-cache.mts",
    "check:llm": "node --import ./scripts/register-hooks.mjs --experimental-strip-types scripts/check-llm.mts",
    "check:wire": "node --import ./scripts/register-hooks.mjs --experimental-strip-types scripts/check-wire.mts",
    "check:scenarios": "node --experimental-strip-types scripts/check-scenarios.mts"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.9",
    "@base-ui/react": "^1.8.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
