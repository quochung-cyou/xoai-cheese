# ============================================
# AI Thực Chiến - Ghi log AI (AI hook)
# ============================================
# Sao chép file này thành .env rồi điền token.
# TUYỆT ĐỐI không commit file .env (đã có trong .gitignore).

# Địa chỉ nhận log của Ban Tổ Chức (BTC). Không cần đổi.
AI_LOG_SERVER=https://live.thucchien.ai/api/ingest

# Token của ĐỘI bạn do BTC cấp (bắt đầu bằng "aitc_").
# Mỗi đội một token; đừng chia sẻ ra ngoài đội.
AI_LOG_API_KEY=

# (Tuỳ chọn) Thư mục chứa log cục bộ. Mặc định .ai-log
# AI_LOG_DIR=.ai-log
