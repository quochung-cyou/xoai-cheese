{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=cursor"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=cursor"
      }
    ],
    "stop": [
      {
        "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=cursor"
      }
    ]
  }
}
